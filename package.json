{
    "name": "@nonnajs/sample-stencil",
    "version": "1.0.0",
    "description": "Sample StencilJS application demonstrating @nonnajs/stencil - @Element()-based injection, <nonna-provider> interop, and @nonnajs/di over Stencil custom elements.",
    "author": "Manuel Santos <ney.br.santos@gmail.com>",
    "license": "MIT",
    "private": true,
    "keywords": [
        "nonna",
        "di",
        "injector",
        "stencil",
        "stencil-js",
        "web-components",
        "vite",
        "sample"
    ],
    "scripts": {
        "compile-deps": "nonna-compile",
        "stencil-build": "stencil build",
        "predev": "pnpm compile-deps && pnpm stencil-build",
        "dev": "vite",
        "prebuild": "pnpm compile-deps && pnpm stencil-build",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "clean:build": "rimraf ./dist ./stencil-dist ./loader ./www",
        "lint": "eslint . --ext .js,.ts,.tsx",
        "lint:fix": "pnpm lint --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "pretest": "pnpm compile-deps",
        "test": "node --test --test-reporter node-test-reporter --require ts-node/register test/**/*.{test,it.test}.ts",
        "tsc": "tsc --noEmit"
    },
    "dependencies": {
        "@nonnajs/di": "workspace:*",
        "@nonnajs/stencil": "workspace:*",
        "@nonnajs/web-components": "workspace:*"
    },
    "devDependencies": {
        "@nonnajs/compiler": "workspace:*",
        "@nonnajs/vite-plugin": "workspace:*",
        "@stencil/core": "^4.45.0",
        "vite": "^5.4.0"
    }
}
